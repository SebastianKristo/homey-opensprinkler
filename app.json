{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "no.opensprinkler",
  "version": "1.2.1",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "OpenSprinkler",
    "no": "OpenSprinkler"
  },
  "description": {
    "en": "Control your OpenSprinkler irrigation controller",
    "no": "Styr OpenSprinkler vanningskontrolleren din"
  },
  "category": [
    "appliances"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "brandColor": "#3B8EEA",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Sebastian Kristoffersen",
    "email": "sebastian@kristo.no"
  },
  "api": {
    "getMeters": {
      "method": "GET",
      "path": "/meters"
    },
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "reset": {
      "method": "POST",
      "path": "/reset"
    },
    "getValves": {
      "method": "GET",
      "path": "/valves"
    },
    "testValve": {
      "method": "POST",
      "path": "/valve/test"
    }
  },
  "flow": {
    "conditions": [
      {
        "title": {
          "en": "Rain delay !{{is|is not}} active",
          "no": "Regnforsinkelse !{{er|er ikke}} aktiv"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=controller"
          }
        ],
        "id": "rain_delay_active"
      },
      {
        "title": {
          "en": "Zone !{{is|is not}} watering",
          "no": "Sone !{{vanner|vanner ikke}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=station"
          }
        ],
        "id": "station_running"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Reset water consumption for all zones",
          "no": "Nullstill vannforbruk for alle soner"
        },
        "id": "reset_water"
      },
      {
        "title": {
          "en": "Run program",
          "no": "Kjør program"
        },
        "titleFormatted": {
          "en": "Run program [[program]] (weather adjust: [[use_weather]])",
          "no": "Kjør program [[program]] (værjustering: [[use_weather]])"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=controller"
          },
          {
            "type": "autocomplete",
            "name": "program",
            "title": {
              "en": "Program",
              "no": "Program"
            }
          },
          {
            "type": "dropdown",
            "name": "use_weather",
            "values": [
              {
                "id": "no",
                "title": {
                  "en": "No",
                  "no": "Nei"
                }
              },
              {
                "id": "yes",
                "title": {
                  "en": "Yes",
                  "no": "Ja"
                }
              }
            ]
          }
        ],
        "id": "run_program"
      },
      {
        "title": {
          "en": "Run zone",
          "no": "Kjør sone"
        },
        "titleFormatted": {
          "en": "Run zone for [[minutes]] minutes",
          "no": "Kjør sone i [[minutes]] minutter"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=station"
          },
          {
            "type": "number",
            "name": "minutes",
            "min": 1,
            "max": 720,
            "title": {
              "en": "Minutes",
              "no": "Minutter"
            }
          }
        ],
        "id": "run_station"
      },
      {
        "title": {
          "en": "Enable/disable program",
          "no": "Aktiver/deaktiver program"
        },
        "titleFormatted": {
          "en": "Turn program [[program]] [[state]]",
          "no": "Slå program [[program]] [[state]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=controller"
          },
          {
            "type": "autocomplete",
            "name": "program",
            "title": {
              "en": "Program",
              "no": "Program"
            }
          },
          {
            "type": "dropdown",
            "name": "state",
            "values": [
              {
                "id": "on",
                "title": {
                  "en": "on",
                  "no": "på"
                }
              },
              {
                "id": "off",
                "title": {
                  "en": "off",
                  "no": "av"
                }
              }
            ]
          }
        ],
        "id": "set_program_enabled"
      },
      {
        "title": {
          "en": "Set rain delay",
          "no": "Sett regnforsinkelse"
        },
        "titleFormatted": {
          "en": "Set rain delay to [[hours]] hours",
          "no": "Sett regnforsinkelse til [[hours]] timer"
        },
        "hint": {
          "en": "0 hours cancels the rain delay.",
          "no": "0 timer avbryter regnforsinkelsen."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=controller"
          },
          {
            "type": "number",
            "name": "hours",
            "min": 0,
            "max": 32767,
            "title": {
              "en": "Hours",
              "no": "Timer"
            }
          }
        ],
        "id": "set_rain_delay"
      },
      {
        "title": {
          "en": "Set water level",
          "no": "Sett vannivå"
        },
        "titleFormatted": {
          "en": "Set water level to [[level]]%",
          "no": "Sett vannivå til [[level]]%"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=controller"
          },
          {
            "type": "number",
            "name": "level",
            "min": 0,
            "max": 250,
            "title": {
              "en": "Percent",
              "no": "Prosent"
            }
          }
        ],
        "id": "set_water_level"
      },
      {
        "title": {
          "en": "Stop all zones",
          "no": "Stopp alle soner"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=controller"
          }
        ],
        "id": "stop_all"
      },
      {
        "title": {
          "en": "Stop zone",
          "no": "Stopp sone"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=station"
          }
        ],
        "id": "stop_station"
      }
    ]
  },
