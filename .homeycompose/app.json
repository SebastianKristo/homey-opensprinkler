{
  "id": "no.kristo.opensprinkler",
  "version": "2.0.2",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "OpenSprinkler",
    "no": "OpenSprinkler"
  },
  "description": {
    "en": "Water your garden smarter with OpenSprinkler",
    "no": "Vann hagen smartere med OpenSprinkler"
  },
  "category": [
    "appliances"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "brandColor": "#3B8EEA",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Sebastian Kristo Jemtland",
    "email": "sebastian@kristo.no"
  },
  "api": {
    "getMeters": {
      "method": "GET",
      "path": "/meters"
    },
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "reset": {
      "method": "POST",
      "path": "/reset"
    },
    "getValves": {
      "method": "GET",
      "path": "/valves"
    },
    "testValve": {
      "method": "POST",
      "path": "/valve/test"
    }
  },
  "tags": {
    "en": [
      "opensprinkler",
      "sprinkler",
      "irrigation",
      "watering",
      "garden",
      "water meter"
    ],
    "no": [
      "opensprinkler",
      "vanning",
      "sprinkler",
      "hage",
      "vannmåler"
    ]
  },
  "source": "https://github.com/SebastianKristo/homey-opensprinkler",
  "bugs": {
    "url": "https://github.com/SebastianKristo/homey-opensprinkler/issues"
  },
  "support": "https://github.com/SebastianKristo/homey-opensprinkler/issues"
}