{
  "id": "no.opensprinkler",
  "version": "1.3.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "OpenSprinkler",
    "no": "OpenSprinkler"
  },
  "description": {
    "en": "Control your OpenSprinkler irrigation controller",
    "no": "Styr OpenSprinkler vanningskontrolleren din"
  },
  "category": [
    "appliances"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "brandColor": "#3B8EEA",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Sebastian Kristoffersen",
    "email": "sebastian@kristo.no"
  },
  "api": {
    "getMeters": {
      "method": "GET",
      "path": "/meters"
    },
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "reset": {
      "method": "POST",
      "path": "/reset"
    },
    "getValves": {
      "method": "GET",
      "path": "/valves"
    },
    "testValve": {
      "method": "POST",
      "path": "/valve/test"
    }
  }
}