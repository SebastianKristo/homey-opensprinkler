    { "id": "start" }
  ],
  "repair": [
    { "id": "start" }
  ],
  "settings": [
    { "id": "host", "type": "text", "label": { "en": "Host / IP", "no": "Vert / IP" }, "value": "" },
    { "id": "password", "type": "password", "label": { "en": "Password (leave empty to keep)", "no": "Passord (tomt = behold)" }, "value": "" },
    { "id": "poll_interval", "type": "number", "label": { "en": "Poll interval", "no": "Oppdateringsintervall" }, "units": { "en": "s" }, "value": 10, "min": 3, "max": 300 }
  ]
}
