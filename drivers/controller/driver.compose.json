{
  "name": { "en": "OpenSprinkler controller", "no": "OpenSprinkler-kontroller" },
  "class": "sprinkler",
  "capabilities": ["onoff", "os_running", "os_water_level", "os_rain_delay", "os_rain_delay_end", "alarm_water"],
  "capabilitiesOptions": {
    "onoff": { "title": { "en": "Controller enabled", "no": "Kontroller aktivert" } },
    "alarm_water": { "title": { "en": "Rain sensor", "no": "Regnsensor" } }
  },
  "platforms": ["local"],
  "connectivity": ["lan"],
  "images": { "small": "{{driverAssetsPath}}/images/small.png", "large": "{{driverAssetsPath}}/images/large.png" },
