{
  "name": {
    "en": "OpenSprinkler zone",
    "no": "OpenSprinkler-sone"
  },
  "class": "sprinkler",
  "capabilities": [
    "onoff",
    "os_status",
    "os_remaining",
    "measure_water",
    "meter_water",
    "os_last_run",
    "button.run_5",
    "button.run_10",
    "button.run_15",
    "button.run_30",
    "button.run_60"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "Watering",
        "no": "Vanner"
      }
    },
    "measure_water": {
      "title": {
        "en": "Water flow",
        "no": "Vannflyt"
      }
    },
    "meter_water": {
      "title": {
        "en": "Water consumption",
        "no": "Vannforbruk"
      },
      "decimals": 3
    },
    "button.run_5": {
      "title": {
        "en": "Run 5 min",
        "no": "Kjør 5 min"
      }
    },
    "button.run_10": {
      "title": {
        "en": "Run 10 min",
        "no": "Kjør 10 min"
      }
    },
    "button.run_15": {
      "title": {
        "en": "Run 15 min",
        "no": "Kjør 15 min"
      }
    },
    "button.run_30": {
      "title": {
        "en": "Run 30 min",
        "no": "Kjør 30 min"
      }
    },
    "button.run_60": {
      "title": {
        "en": "Run 60 min",
        "no": "Kjør 60 min"
      }
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "duration",
      "type": "number",
      "label": {
        "en": "Default run time",
        "no": "Standard kjøretid"
      },
      "units": {
        "en": "min"
      },
      "value": 10,
      "min": 1,
      "max": 720,
      "hint": {
        "en": "Used when the zone is switched on from Homey.",
        "no": "Brukes når sonen slås på fra Homey."
      }
    },
    {
      "id": "sprinkler_type",
      "type": "dropdown",
      "label": {
        "en": "Zone type",
        "no": "Sonetype"
      },
      "value": "drip",
      "hint": {
        "en": "The icon follows the type. Homey only applies a new icon when the zone is paired again.",
        "no": "Ikonet følger typen. Homey bytter ikon først når sonen pares på nytt."
      },
      "values": [
        {
          "id": "drip",
          "label": {
            "en": "Drip",
            "no": "Drypp"
          }
        },
        {
          "id": "spray",
          "label": {
            "en": "Sprinkler",
            "no": "Spreder"
          }
        }
      ]
    }
  ]
}